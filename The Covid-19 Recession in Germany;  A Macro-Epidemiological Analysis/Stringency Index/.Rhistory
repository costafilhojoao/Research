order=c, method = "ML")
coefs[i,] <- coef(ar1)
se[i,]    <- lmtest::coeftest(ar1)[,2]
}
for (i in 1:nrow(coefs)){
ar1 <- arima(taul[(1+i-1):(w+i-1)],
order=c(1,0,0), method = "ML")
coefs[i,] <- coef(ar1)
se[i,]    <- lmtest::coeftest(ar1)[,2]
}
ar <- ts( coefs[,1], start=time(taul)[w], freq=4)
ep  <- ts( se[,1],    start=time(taul)[w], freq=4)
sup <- ar + 1.64 * ep
inf <- ar - 1.64 * ep
### Gráfico
plot(ar, lwd=3, xlab='', ylab='', main = ' ', col = 'darkred')
